# =================================================================
# Production Environment Variables for Render (Web Service)
# Copy these key-value pairs into Render: Service > Environment
# =================================================================

APP_NAME="Car Shop Management System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:52wDiJlCDDA9zdBadfkx0jfQcmgd84oPWxODcPH47HE=

# Replace with your actual Render URL (once created)
APP_URL=https://your-car-backend.onrender.com

# Replace with your actual Vercel URL (for CORS allowance)
FRONTEND_URL=https://your-car-frontend.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# =================================================================
# Supabase PostgreSQL Database Settings
# (Found in Supabase: Project Settings > Database > Connection Parameters)
# =================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_db_password
DB_SSLMODE=require

# =================================================================
# Session, Cache, Filesystem Drivers
# =================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
